{
  /*
   * Development overrides — values here take precedence over appsettings.json
   * when ASPNETCORE_ENVIRONMENT=Development (the default for `dotnet run`).
   *
   * For local SQL Server with Windows Authentication:
   *   "Server=localhost;Database=PatientDB;Integrated Security=True;TrustServerCertificate=True;"
   *
   * Prefer `dotnet user-secrets` so even these dev values stay out of git.
   * To initialise user-secrets for this project:
   *   cd PatientSyncApi
   *   dotnet user-secrets init
   *   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Server=localhost;..."
   *   dotnet user-secrets set "ApiKey" "dev-key-only"
   */
  "ConnectionStrings": {
