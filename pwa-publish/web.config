<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Serve static files directly -->
    <staticContent>

      <!-- service-worker.js: must NEVER be cached by the browser or CDN.
           Browsers check for SW updates on every navigation — if they get a
           stale copy, users are stuck on the old cache forever.
           Cache-Control: no-store tells both the browser and Cloudflare
           to always fetch this file from the origin. -->
      <clientCache cacheControlMode="DisableCache" />

    </staticContent>

    <!-- Per-file Cache-Control overrides via outbound rules -->
    <httpProtocol>
      <customHeaders>
        <!-- Remove the IIS default max-age so Cloudflare doesn't over-cache -->

        <!--
          Content-Security-Policy
          ─────────────────────────────────────────────────────────────────────
          Restricts what the browser may load or execute, blocking the primary
          attack vector for XSS (Cross-Site Scripting — OWASP A03:2021).

          script-src:
            'self'                 — local app.js, db.js, service-worker.js
            'wasm-unsafe-eval'     — required by sql.js WebAssembly compilation
            cdnjs.cloudflare.com   — sql-wasm.js (loaded with SRI integrity hash)
            cdn.jsdelivr.net       — Bootstrap JS + ExcelJS (loaded with SRI hash)

          style-src:
            'self'                 — style.css
            'unsafe-inline'        — Bootstrap and the app use inline style= attrs
            cdn.jsdelivr.net       — Bootstrap CSS

          connect-src:
            'self'                 — service-worker fetch, local DB ops
            https://api.etbr.org   — all API calls

          img-src:
            'self' data: blob:     — self + base64 avatars + generated file previews

          worker-src 'self'        — service-worker.js registration
          font-src   'self'        — no external fonts
          object-src 'none'        — block <object>/<embed>/<applet> (plugin attacks)
          base-uri   'self'        — prevent <base> hijacking
          frame-ancestors 'none'   — equivalent to X-Frame-Options: DENY
        -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob:; connect-src 'self' https://api.etbr.org https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cloudflareinsights.com https://static.cloudflareinsights.com; worker-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" />

        <!-- Prevent MIME-type sniffing attacks (OWASP A05:2021) -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- Belt-and-suspenders clickjacking protection (CSP frame-ancestors above is primary) -->
        <add name="X-Frame-Options" value="DENY" />

        <!-- Limit Referer header to origin only when crossing to a different origin -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <outboundRules>

        <!-- service-worker.js → no-store (always fetch fresh) -->
        <rule name="NoCache-ServiceWorker">
          <match serverVariable="RESPONSE_Cache_Control"
                 pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="service-worker\.js$" />
          </conditions>
          <action type="Rewrite" value="no-store, no-cache, must-revalidate" />
        </rule>

        <!-- app.js, style.css, index.html → short cache (5 min) so CDN
             picks up updates quickly after a deploy + purge -->
        <rule name="ShortCache-AppShell">
          <match serverVariable="RESPONSE_Cache_Control"
                 pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}"
                 pattern="\.(js|css|html)$" />
            <!-- Exclude service-worker.js — already handled above -->
            <add input="{REQUEST_URI}"
                 pattern="service-worker\.js$"
                 negate="true" />
          </conditions>
          <action type="Rewrite" value="public, max-age=300, must-revalidate" />
        </rule>

      </outboundRules>
    </rewrite>

  </system.webServer>
</configuration>
